<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_inherit_intercompany" model="ir.ui.view">
        <field name="name">res.company.form.intercompany</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <field name="vat" position="after"> 
                <group string="Inter-sociétés" name="intercompany_settings">
                    <field name="is_subcontractor"/>
                </group>
            </field>
        </field>
    </record>
</odoo>