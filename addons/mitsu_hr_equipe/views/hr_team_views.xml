<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_employee_team_tree" model="ir.ui.view">
        <field name="name">hr.employee.team.list</field>
        <field name="model">hr.employee.team</field>
        <field name="arch" type="xml">
            <list string="Équipes">
                <field name="name"/>
                <field name="team_leader_id" widget="many2one_avatar_user"/>
                <field name="member_count"/>
            </list>
        </field>
    </record>

    <record id="view_hr_employee_team_form" model="ir.ui.view">
        <field name="name">hr.employee.team.form</field>
        <field name="model">hr.employee.team</field>
        <field name="arch" type="xml">
            <form string="Équipe">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" placeholder="Ex: Équipe Maintenance"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="team_leader_id" widget="many2one_avatar_user"/>
                        </group>
                        <group>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Membres" name="members">
                            <field name="member_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="work_email"/>
                                    <field name="department_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_employee_team_action" model="ir.actions.act_window">
        <field name="name">Équipes RH</field>
        <field name="res_model">hr.employee.team</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_hr_employee_team" 
              name="Équipes" 
              parent="hr.menu_hr_root" 
              action="hr_employee_team_action" 
              sequence="50"/>
</odoo>